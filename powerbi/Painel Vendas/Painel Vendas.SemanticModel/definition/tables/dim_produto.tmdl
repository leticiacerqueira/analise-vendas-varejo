table dim_produto
	lineageTag: c72465bf-fd06-5d52-af90-13b804fbf940

	column sku
		dataType: string
		summarizeBy: none
		lineageTag: 8faf4ac9-6d6c-5a44-84cd-1c378aabe4ba
		sourceColumn: sku

	column produto
		dataType: string
		summarizeBy: none
		lineageTag: 51b20ee1-1e13-56bd-8e09-16fcf9231fc0
		sourceColumn: produto

	column categoria
		dataType: string
		summarizeBy: none
		lineageTag: 552e0e30-464c-53b9-93b0-9005d897c199
		sourceColumn: categoria

	column fornecedor
		dataType: string
		summarizeBy: none
		lineageTag: b8d9c303-75c3-509b-9319-9a8a39e8d51a
		sourceColumn: fornecedor

	column preco_tabela
		dataType: double

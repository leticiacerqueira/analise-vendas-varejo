	partition dim_produto = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(Web.Contents("https://raw.githubusercontent.com/leticiacerqueira/analise-vendas-varejo/main/saida/powerbi/dim_produto.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"sku", type text}, {"produto", type text}, {"categoria", type text}, {"fornecedor", type text}, {"preco_tabela", type number}, {"custo_unit", type number}}, "en-US")
				in
				    Tipos

